module fifo_wr_ctrl #(
    parameter ADDR_WIDTH = 4
)(
    input  wire                  wr_clk,
    input  wire                  rst,
    input  wire                  wr_en,
    input  wire                  full,

    output reg  [ADDR_WIDTH-1:0] wr_addr,
    output reg  [ADDR_WIDTH:0]   wr_ptr_gray
);

    // Binary write pointer
    reg [ADDR_WIDTH:0] wr_ptr_bin;

    // -------------------------------------------------
    // Write Pointer Logic
    // -------------------------------------------------
    always @(posedge wr_clk or posedge rst) begin

        // Reset condition
        if (rst) begin
            wr_ptr_bin  <= 0;
            wr_ptr_gray <= 0;
            wr_addr     <= 0;
        end

        // Write operation
        else if (wr_en && !full) begin

            // Current memory address
            wr_addr <= wr_ptr_bin[ADDR_WIDTH-1:0];

            // Increment binary pointer
            wr_ptr_bin <= wr_ptr_bin + 1;

            // Convert next binary pointer to Gray code
            wr_ptr_gray <= (wr_ptr_bin + 1) ^
                            ((wr_ptr_bin + 1) >> 1);
        end
    end

endmodule
